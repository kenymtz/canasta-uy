# Secretos
.env
*.pem

# Datos: se descargan con los pipelines, no se versionan
data/raw/*
data/inbox/*
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Web
web/node_modules/
web/dist/

# Exportaciones de n8n con credenciales (exportá solo workflows)
n8n/**/credentials*.json

# Sistema
.DS_Store
Thumbs.db

# Banco de pruebas de boletas: lo generado se rehace con un comando y las fotos reales pueden
# tener datos personales (nunca se suben)
eval/boletas/node_modules/
eval/boletas/generadas/
eval/boletas/resultados/
eval/boletas/reales/
eval/boletas/variantes/
